server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types application/javascript application/json image/svg+xml text/css text/plain;

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # The browser sends Faro data to its own origin. The deployment supplies
    # the internal Alloy Service or Nomad bridge as the runtime upstream.
    location = /collect {
        resolver ${FARO_DNS_RESOLVER} valid=10s ipv6=off;
        set $faro_collector_upstream ${FARO_COLLECTOR_UPSTREAM};
        proxy_pass http://$faro_collector_upstream/collect;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~* \.(js|css|woff2?|ico|png|jpg|jpeg|gif|webp|avif|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
