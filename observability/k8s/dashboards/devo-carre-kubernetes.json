{
  "annotations": {"list": []},
  "description": "Kubernetes platform health for the local Devo Carre kind cluster. Container telemetry is scraped from the kubelet cAdvisor endpoint and state from kube-state-metrics.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {"includeTimeRange": true, "keepTime": true, "targetBlank": false, "title": "Application overview", "type": "link", "url": "/d/devo-carre-overview"},
    {"includeTimeRange": true, "keepTime": true, "targetBlank": false, "title": "Frontend UX", "type": "link", "url": "/d/devo-carre-frontend"}
  ],
  "panels": [
    {"id": 1, "type": "stat", "title": "Ready Nodes", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "targets": [{"expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "refId": "A"}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"id": 2, "type": "stat", "title": "Running Pods", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}, "targets": [{"expr": "sum(kube_pod_status_phase{phase=\"Running\"})", "refId": "A"}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"id": 3, "type": "stat", "title": "Container Restarts (1h)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}, "targets": [{"expr": "sum(increase(kube_pod_container_status_restarts_total[1h]))", "refId": "A"}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"id": 4, "type": "stat", "title": "cAdvisor Scrape", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}, "targets": [{"expr": "max(up{job=\"kubernetes-cadvisor\"})", "refId": "A"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"id": 5, "type": "stat", "title": "Alloy Receiver", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}, "targets": [{"expr": "max(up{job=\"alloy\"})", "refId": "A"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"id": 6, "type": "timeseries", "title": "Pod CPU by Namespace", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-cadvisor\",container!=\"\",image!=\"\"}[$__rate_interval]))", "legendFormat": "{{namespace}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 7, "type": "timeseries", "title": "Pod Memory by Namespace", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"expr": "sum by (namespace) (container_memory_working_set_bytes{job=\"kubernetes-cadvisor\",container!=\"\",image!=\"\"})", "legendFormat": "{{namespace}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 8, "type": "timeseries", "title": "Top Pod CPU", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"expr": "topk(10, sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-cadvisor\",container!=\"\",image!=\"\"}[$__rate_interval])))", "legendFormat": "{{namespace}} / {{pod}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 9, "type": "timeseries", "title": "Top Pod Memory", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "targets": [{"expr": "topk(10, sum by (namespace, pod) (container_memory_working_set_bytes{job=\"kubernetes-cadvisor\",container!=\"\",image!=\"\"}))", "legendFormat": "{{namespace}} / {{pod}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 10, "type": "logs", "title": "Devo Carre Kubernetes Pod Logs", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 11, "w": 24, "x": 0, "y": 20}, "targets": [{"expr": "{namespace=\"devoteam\", job=\"kubernetes-pod\"}", "refId": "A"}], "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true}}
  ],
  "schemaVersion": 39,
  "tags": ["devo-carre", "kubernetes", "kind"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Devo Carre / Kubernetes Platform",
  "uid": "devo-carre-kubernetes",
  "version": 1
}
